---
import { parts } from "../../content/book";

interface Props { currentSlug?: string }
const { currentSlug } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const chapterUrl = (slug: string) => `${base}chapters/${slug}/`;
---

<nav class="book-tree" aria-label="全书章节">
  <a class="tree-home" href={`${base}contents/`}><span>全书目录</span><b>47章</b></a>
  {parts.map((part) => {
    const isCurrentPart = part.chapters.some((chapter) => chapter.slug === currentSlug);
    return (
      <details class={`tree-part part-${part.color}`} open={isCurrentPart}>
        <summary>
          <span>卷 {String(part.number).padStart(2, "0")}</span>
          <b>{part.title}</b>
        </summary>
        <div class="tree-chapters">
          {part.chapters.map((chapter) => {
            const active = chapter.slug === currentSlug;
            return (
              <a class:list={[{ active }]} href={chapterUrl(chapter.slug)} aria-current={active ? "page" : undefined}>
                <span>{String(chapter.number).padStart(2, "0")}</span>
                <b>{chapter.title}</b>
                {chapter.status === "sample" && <i>样板</i>}
              </a>
            );
          })}
        </div>
      </details>
    );
  })}
</nav>
