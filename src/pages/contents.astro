---
import BookLayout from "../layouts/BookLayout.astro";
import { chapterCount, parts } from "../content/book";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const chapterUrl = (slug: string) => `${base}chapters/${slug}/`;
const statusLabel = { sample: "样板章", outlined: "重点筹备", planned: "内容骨架" } as const;
---

<BookLayout title="全书目录｜可执行的智慧" description={`《可执行的智慧》全书内容骨架：7卷，${chapterCount}章。`}>
  <main class="contents-page">
    <header class="book-subnav">
      <a class="brand" href={base}><span class="brand-mark">算</span><span>可执行的智慧</span></a>
      <a class="quiet-link" href={base}>返回首页</a>
    </header>

    <section class="contents-hero">
      <p class="eyebrow"><span></span> 全书内容骨架</p>
      <h1>七个问题领域，<br /><em>{chapterCount}</em> 次思想跨越</h1>
      <p>目录同时沿着历史前进，也沿着人类面对的问题展开。每一章都预先定义了历史现场、核心问题、算法思想和浏览器实验。</p>
      <div class="contents-legend"><span><i class="sample-dot"></i> 已有样板</span><span><i class="outline-dot"></i> 重点筹备</span><span><i></i> 内容骨架</span></div>
    </section>

    <div class="parts-list">
      {parts.map((part) => (
        <section class={`part-block part-${part.color}`} id={part.slug}>
          <div class="part-intro">
            <div class="part-number">卷 {String(part.number).padStart(2, "0")}</div>
            <p>{part.span}</p>
            <h2>{part.title}</h2>
            <p class="part-subtitle">{part.subtitle}</p>
          </div>
          <ol class="chapter-list" start={part.chapters[0].number}>
            {part.chapters.map((chapter) => (
              <li>
                <a href={chapterUrl(chapter.slug)}>
                  <span class="chapter-number">{String(chapter.number).padStart(2, "0")}</span>
                  <span class="chapter-name"><b>{chapter.title}</b><small>{chapter.question}</small></span>
                  <span class={`status status-${chapter.status ?? "planned"}`}>{statusLabel[chapter.status ?? "planned"]}</span>
                  <span class="chapter-arrow">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
</BookLayout>
