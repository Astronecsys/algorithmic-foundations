---
import BookLayout from "./BookLayout.astro";
import BookNav from "../components/book/BookNav.astro";
import { chapters } from "../content/book";

interface Heading { id: string; label: string }
interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  headings?: Heading[];
  frontmatter?: { title?: string; description?: string; slug?: string; headings?: Heading[] };
}

const { title, description, currentSlug, headings, frontmatter } = Astro.props;
const slug = frontmatter?.slug ?? currentSlug ?? "";
const pageTitle = frontmatter?.title ?? title ?? "可执行的智慧";
const pageDescription = frontmatter?.description ?? description;
const pageHeadings = frontmatter?.headings ?? headings ?? [];
const chapter = chapters.find((candidate) => candidate.slug === slug);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BookLayout title={pageTitle} description={pageDescription}>
  <div class="reading-app">
    <header class="reading-topbar">
      <a class="reading-brand" href={base}><span class="brand-mark">算</span><b>可执行的智慧</b></a>
      <span class="topbar-divider"></span>
      <span class="topbar-location">{chapter ? `第 ${chapter.number} 章 · ${chapter.title}` : pageTitle}</span>
      <div class="topbar-actions">
        <a href={`${base}contents/`} aria-label="打开全书目录">目录</a>
        <a href="https://github.com/Astronecsys/executable-wisdom" aria-label="在GitHub查看源码">GitHub ↗</a>
      </div>
      <details class="mobile-book-menu">
        <summary>章节目录</summary>
        <div class="mobile-book-drawer"><BookNav currentSlug={slug} /></div>
      </details>
    </header>

    <div class="reading-frame">
      <aside class="reading-sidebar"><BookNav currentSlug={slug} /></aside>
      <main class="reading-main"><slot /></main>
      <aside class="reading-toc">
        <p>本页内容</p>
        <nav aria-label="本页目录">
          {pageHeadings.map((heading) => <a href={`#${heading.id}`}>{heading.label}</a>)}
        </nav>
        <div class="toc-progress"><span></span><small>内容骨架</small></div>
      </aside>
    </div>
  </div>
</BookLayout>
