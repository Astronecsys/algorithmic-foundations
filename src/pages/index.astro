---
import BookLayout from "../layouts/BookLayout.astro";
import { chapterCount, parts } from "../content/book";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const guideUrl = `${base}guide/`;
---

<BookLayout title="现代生活的算法基座｜互动算法文明史" description="从古代计算术到现代科学工程，理解支撑现代生活的算法思想。">
  <main class="landing">
    <header class="landing-header">
      <a class="landing-brand" href={base}><span>算</span><b>现代生活的算法基座</b><small>Algorithmic Foundations</small></a>
      <nav aria-label="主导航">
        <a href={`${base}contents/`}>全书目录</a>
        <a href={guideUrl}>开始阅读</a>
        <a href="https://github.com/Astronecsys/algorithmic-foundations">GitHub ↗</a>
      </nav>
    </header>

    <section class="cover">
      <div class="cover-copy">
        <p class="overline">一部可以亲手运行的算法文明史</p>
        <h1>现代生活的<br /><em>算法基座</em></h1>
        <p class="cover-deck">从搜索路线、医学成像到网络通信，现代生活建立在一层层算法思想之上。它们并不始于计算机，而始于人类把困难变成明确、可靠、可以检验的步骤。</p>
        <div class="cover-actions">
          <a class="button-primary" href={guideUrl}>先读全书导言 <span>→</span></a>
          <a class="button-secondary" href={`${base}contents/`}>浏览 {chapterCount} 章目录</a>
        </div>
      </div>
      <aside class="cover-object" aria-label="本书跨度">
        <div class="object-head"><span>BOOK 01</span><span>持续写作中</span></div>
        <div class="object-center"><small>从</small><strong>约前<br />1800</strong><i></i><small>到</small><strong>今天</strong></div>
        <div class="object-foot"><span>7 卷</span><span>{chapterCount} 章</span><span>互动实验</span></div>
      </aside>
    </section>

    <section class="book-promise">
      <div class="promise-title"><span>为什么写这本书</span><h2>计算机只是其中一章，<br />解决问题才是主线。</h2></div>
      <div class="promise-grid">
        <article><span>01</span><h3>从问题出发</h3><p>先回到算法诞生时的困境，再引入现代符号和定义。</p></article>
        <article><span>02</span><h3>让思想可操纵</h3><p>通过预测、单步执行和极端输入，暴露方法真正依赖的结构。</p></article>
        <article><span>03</span><h3>追踪现实回声</h3><p>把数论、测量、控制、成像、生命和社会放回同一条历史长河。</p></article>
      </div>
    </section>

    <section class="volume-index">
      <header><p class="overline">全书结构</p><h2>七条解决问题的主线</h2><a href={`${base}contents/`}>打开完整目录 →</a></header>
      <ol>
        {parts.map((part) => (
          <li class={`part-${part.color}`}>
            <a href={`${base}contents/#${part.slug}`}>
              <span>{String(part.number).padStart(2, "0")}</span>
              <div><h3>{part.title}</h3><p>{part.subtitle}</p></div>
              <small>{part.foundation}<br />{part.span}</small>
              <b>{part.chapters.length} 章</b>
              <em>↗</em>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="sample-invitation">
      <div><p class="overline">样板章 · 第 04 章</p><h2>不要只看懂，<br />亲手让它发生。</h2></div>
      <div><p>改变两个整数，预测余数，逐步运行欧几里得算法，并在过程中发现它保存答案的不变量。</p><a class="button-light" href={`${base}chapters/euclid/`}>进入互动样板章 <span>→</span></a></div>
    </section>

    <footer class="landing-footer"><b>现代生活的算法基座</b><span>开源、免费、持续写作</span><a href="https://github.com/Astronecsys/algorithmic-foundations">查看源代码 ↗</a></footer>
  </main>
</BookLayout>
