---
import BookLayout from "../../layouts/BookLayout.astro";
import { chapters, parts, type Chapter, type Part } from "../../content/book";

export function getStaticPaths() {
  return chapters
    .filter((chapter) => chapter.slug !== "euclid")
    .map((chapter, index) => ({
      params: { slug: chapter.slug },
      props: {
        chapter,
        part: parts.find((candidate) => candidate.number === chapter.partNumber),
        previous: chapters[index - 1],
        next: chapters[index + 1],
      },
    }));
}

interface Props {
  chapter: Chapter & { partNumber: number; partSlug: string; partTitle: string };
  part: Part;
  previous?: Chapter;
  next?: Chapter;
}

const { chapter, part, previous, next } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const chapterUrl = (slug: string) => `${base}chapters/${slug}/`;
---

<BookLayout title={`${chapter.title}｜可执行的智慧`} description={chapter.question}>
  <main class="skeleton-page">
    <header class="book-subnav">
      <a class="brand" href={base}><span class="brand-mark">算</span><span>可执行的智慧</span></a>
      <a class="quiet-link" href={`${base}contents/`}>全书目录</a>
    </header>

    <article>
      <div class="chapter-masthead">
        <div class="chapter-kicker">卷 {String(part.number).padStart(2, "0")} · 第 {String(chapter.number).padStart(2, "0")} 章</div>
        <h1>{chapter.title}</h1>
        <p class="chapter-question">{chapter.question}</p>
        <div class="chapter-meta"><span>{chapter.period}</span><span>{part.title}</span><span>内容骨架</span></div>
      </div>

      <div class="skeleton-grid">
        <aside class={`chapter-rail part-${part.color}`}>
          <p>本章所在主线</p>
          <h2>{part.title}</h2>
          <p>{part.subtitle}</p>
          <a href={`${base}contents/#${part.slug}`}>查看本卷目录 →</a>
        </aside>

        <div class="chapter-scaffold">
          <section>
            <span class="scaffold-label">01 · 历史现场</span>
            <h2>人们为什么需要它？</h2>
            <p>本节将从具体人物、器物、制度或科学问题进入，说明当时有哪些已知方法、它们为什么不够，以及新算法解决了哪一个真正的困难。</p>
          </section>
          <section>
            <span class="scaffold-label">02 · 核心思想</span>
            <h2>{chapter.idea}</h2>
            <p>先通过图形和操作形成直觉，再把直觉连接到状态、步骤、不变量、终止条件与误差边界。</p>
          </section>
          <section class="planned-lab">
            <span class="scaffold-label">03 · 计划中的互动实验</span>
            <h2>{chapter.lab}</h2>
            <div class="lab-placeholder">
              <div class="placeholder-controls"><i></i><i></i><i></i></div>
              <div class="placeholder-stage"><span>输入</span><b>→</b><span>逐步执行</span><b>→</b><span>解释</span></div>
            </div>
          </section>
          <section>
            <span class="scaffold-label">04 · 理解与证明</span>
            <h2>它为什么有效，又会在哪里失败？</h2>
            <p>读者将尝试边界输入、寻找反例、归纳不变量，并用自己的语言解释正确性、效率或近似误差。</p>
          </section>
          <section>
            <span class="scaffold-label">05 · 现实回声</span>
            <h2>这个思想后来去了哪里？</h2>
            <p>本节追踪算法在其他领域中的迁移、今天仍可见的应用，以及它造成的新限制、新风险或价值选择。</p>
          </section>
          <section class="source-skeleton">
            <span class="scaffold-label">史料与引用状态</span>
            <p>尚待建立一手史料、可靠二手研究、数学定义和实现来源。正文撰写前必须完成来源分级与交叉核验。</p>
          </section>
        </div>
      </div>
    </article>

    <nav class="chapter-pagination" aria-label="章节翻页">
      {previous ? <a href={chapterUrl(previous.slug)}><small>上一章</small><span>← {previous.title}</span></a> : <span></span>}
      {next ? <a class="next-chapter" href={chapterUrl(next.slug)}><small>下一章</small><span>{next.title} →</span></a> : <span></span>}
    </nav>
  </main>
</BookLayout>
